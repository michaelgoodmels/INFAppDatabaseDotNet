@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anmelden - IMS25T</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary-blue: #1e3a8a;
            --secondary-blue: #3b82f6;
            --dark-bg: #0f172a;
            --darker-bg: #0a0f1f;
            --card-bg: #1e293b;
            --border-blue: #3b82f6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--darker-bg) 100%);
            color: #e2e8f0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-box {
            background-color: var(--card-bg);
            border: 2px solid var(--border-blue);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }

        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo img {
            height: 80px;
            margin-bottom: 20px;
        }

        .logo h1 {
            color: white;
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .logo p {
            color: #94a3b8;
            font-size: 0.95rem;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            background-color: #0f172a;
            border: 1px solid var(--border-blue);
            color: #e2e8f0;
            padding: 12px;
            border-radius: 6px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background-color: #0f172a;
            color: #e2e8f0;
            border-color: #60a5fa;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

        .form-control::placeholder {
            color: #64748b;
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            border: none;
            color: white;
            padding: 12px;
            font-weight: 600;
            border-radius: 6px;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

        .btn-login:hover {
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
            transform: translateY(-2px);
            color: white;
        }

        .alert {
            border-radius: 8px;
            border: 1px solid;
            margin-bottom: 20px;
        }

        .alert-danger {
            background-color: #7f1d1d;
            border-color: #dc2626;
            color: #fecaca;
        }

        .error-icon {
            margin-right: 10px;
        }

        .info-box {
            background-color: #0c4a6e;
            border-left: 4px solid var(--secondary-blue);
            padding: 15px;
            border-radius: 6px;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        .info-box h5 {
            color: #bfdbfe;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .info-box p {
            color: #cbd5e1;
            margin-bottom: 5px;
        }

        .info-box code {
            background-color: #1e293b;
            color: #60a5fa;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.85rem;
        }

        @@media (max-width: 480px) {
            .login-box {
                padding: 25px 20px;
            }

            .logo h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <!-- Logo und Titel -->
            <div class="logo">
                <img src="/Content/images/bzbs_logo.png" alt="BZBS Logo" />
                <h1>IMS25T</h1>
                <p>Notenverwaltungssystem</p>
            </div>

            <!-- Error-Meldung -->
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle error-icon"></i>
                    @ViewBag.Error
                </div>
            }

            <!-- Login-Formular -->
            <form method="post" action="@Url.Action("Index", "Login")">
                <div class="form-group">
                    <label class="form-label" for="username">
                        <i class="fas fa-user"></i> Benutzername
                    </label>
                    <input type="text" class="form-control" id="username" name="username" 
                           placeholder="Benutzername eingeben" required autofocus />
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">
                        <i class="fas fa-lock"></i> Passwort
                    </label>
                    <input type="password" class="form-control" id="password" name="password" 
                           placeholder="Passwort eingeben" required />
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i> Anmelden
                </button>
            </form>

            <!-- Info-Box fÃ¼r Test-Daten -->
            <div class="info-box">
                <h5><i class="fas fa-info-circle"></i> Test-Anmeldedaten:</h5>
                <p><strong>SchÃ¼ler:</strong></p>
                <p>Benutzername: <code>BolohanSergiu</code></p>
                <p>Passwort: <code>buchssg</code></p>
                <hr style="border-color: #334155; margin: 10px 0;">
                <p><strong>Admin:</strong></p>
                <p>Benutzername: <code>FastenbauerVerena</code></p>
                <p>Passwort: <code>fastenbauer</code></p>
            </div>
        </div>
    </div>
</body>
</html>
