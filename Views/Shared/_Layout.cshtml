<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>INFAppDatabaseDotNet - Notenverwaltung</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom CSS -->
    <style>
        :root {
            --primary-blue: #1e3a8a;
            --secondary-blue: #3b82f6;
            --light-blue: #dbeafe;
            --dark-bg: #0f172a;
            --darker-bg: #0a0f1f;
            --card-bg: #1e293b;
            --border-blue: #3b82f6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            background-color: var(--dark-bg);
            color: #e2e8f0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        /* Navigation */
        .navbar {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            border-bottom: 2px solid var(--border-blue);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-brand img {
            height: 40px;
        }

        .nav-link {
            color: #e2e8f0 !important;
            transition: all 0.3s ease;
            margin-left: 10px;
        }

        .nav-link:hover {
            color: var(--light-blue) !important;
            transform: translateY(-2px);
        }

        /* Container */
        .container-fluid {
            padding: 30px 20px;
            max-width: 100%;
        }

        /* Cards */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-blue);
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
            color: #e2e8f0;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.2);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            border-bottom: 2px solid var(--border-blue);
            color: white;
        }

        /* Buttons */
        .btn-primary {
            background-color: var(--secondary-blue);
            border-color: var(--secondary-blue);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        }

        .btn-secondary {
            background-color: #475569;
            border-color: #475569;
        }

        .btn-secondary:hover {
            background-color: #64748b;
            border-color: #64748b;
        }

        /* Form Controls */
        .form-control {
            background-color: #1e293b;
            border: 1px solid var(--border-blue);
            color: #e2e8f0;
        }

        .form-control:focus {
            background-color: #1e293b;
            color: #e2e8f0;
            border-color: var(--secondary-blue);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 500;
        }

        /* Tables */
        .table {
            color: #e2e8f0;
        }

        .table-dark {
            background-color: var(--card-bg);
        }

        .table-dark thead th {
            background-color: var(--primary-blue);
            border-color: var(--border-blue);
            color: white;
        }

        .table-dark tbody td {
            border-color: #334155;
        }

        .table-dark tbody tr:hover {
            background-color: #0f172a;
        }

        /* Alerts */
        .alert {
            border-radius: 8px;
            border: 1px solid;
        }

        .alert-danger {
            background-color: #7f1d1d;
            border-color: #dc2626;
            color: #fecaca;
        }

        .alert-success {
            background-color: #1b4332;
            border-color: #22c55e;
            color: #bbf7d0;
        }

        .alert-info {
            background-color: #0c4a6e;
            border-color: var(--secondary-blue);
            color: #bfdbfe;
        }

        /* Footer */
        footer {
            background-color: var(--darker-bg);
            border-top: 2px solid var(--border-blue);
            padding: 20px;
            text-align: center;
            color: #94a3b8;
            margin-top: 40px;
        }

        footer small {
            display: block;
            margin-top: 5px;
        }

        /* Login Page */
        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--darker-bg) 100%);
        }

        .login-box {
            background-color: var(--card-bg);
            border: 2px solid var(--border-blue);
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }

        .login-box h2 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            font-weight: bold;
        }

        .login-box .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-box .logo img {
            height: 60px;
        }

        /* Badge */
        .badge {
            padding: 8px 12px;
            border-radius: 6px;
            font-weight: 600;
        }

        .badge-primary {
            background-color: var(--secondary-blue);
        }

        .badge-success {
            background-color: #22c55e;
        }

        /* Input Grade */
        .grade-input {
            background-color: #1e293b;
            border: 1px solid var(--border-blue);
            color: #e2e8f0;
            text-align: center;
            font-weight: bold;
            border-radius: 6px;
        }

        .grade-input:focus {
            border-color: var(--secondary-blue);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

        /* Module Cards */
        .module-card {
            background-color: #1e293b;
            border-left: 4px solid var(--secondary-blue);
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

        .module-card:hover {
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
            transform: translateX(5px);
        }

        /* Average Grade Display */
        .average-grade-display {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
        }

        .average-grade-display h3 {
            color: #bfdbfe;
            margin-bottom: 10px;
        }

        .average-grade-display .grade-value {
            font-size: 2.5rem;
            color: white;
            font-weight: bold;
        }

        /* Loading Spinner */
        .spinner-border {
            color: var(--secondary-blue);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 15px 10px;
            }

            .login-box {
                padding: 30px 20px;
            }

            .navbar-collapse {
                background-color: var(--darker-bg);
                border-top: 2px solid var(--border-blue);
            }
        }

        /* Section Rendering (fuer Struktur) */
        .section {
            margin-bottom: 30px;
        }

        .section-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 15px 20px;
            border-radius: 8px 8px 0 0;
            color: white;
            border-bottom: 2px solid var(--border-blue);
        }

        .section-body {
            background-color: var(--card-bg);
            padding: 20px;
            border: 1px solid var(--border-blue);
            border-top: none;
            border-radius: 0 0 8px 8px;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~/images/bzbs_logo.png")" alt="BZBS Logo" />
                <span>INFAppDatabaseDotNet</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (@Context.Session.GetString("UserId") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="fas fa-user"></i> @(Context.Session.GetString("FullName") ?? "")
                            </span>
                        </li>
                        @if (@Context.Session.GetString("Role") == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Student")">
                                    <i class="fas fa-chart-line"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Profile", "Student")">
                                    <i class="fas fa-id-card"></i> Profil
                                </a>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="fas fa-tachometer-alt"></i> Admin-Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("AllGrades", "Admin")">
                                    <i class="fas fa-list"></i> Alle Noten
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Statistics", "Admin")">
                                    <i class="fas fa-chart-bar"></i> Statistiken
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <form action="@Url.Action("Logout", "Login")" method="post" style="display:inline;">
                                <button type="submit" class="nav-link btn btn-link">
                                    <i class="fas fa-sign-out-alt"></i> Abmelden
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Login")">
                                <i class="fas fa-sign-in-alt"></i> Anmelden
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2024 BZBS - Informatiker Applikationsentwicklung</p>
        <small>Notenverwaltungssystem - INFAppDatabaseDotNet</small>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery (optional) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>
