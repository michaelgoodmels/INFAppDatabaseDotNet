@model INFAppDatabaseDotNet.Models.StudentModulesViewModel

@{
    ViewBag.Title = "Schueler Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <h1><i class="fas fa-user-graduate"></i> @Model.StudentName</h1>
        <p class="text-muted">Notenverwaltung fuer diesen Schueler</p>
    </div>
</div>

<!-- Gesamtdurchschnitt -->
<div class="row mb-4">
    <div class="col-lg-6 mx-auto">
        <div style="display: flex; gap: 20px; align-items: center;">
            <div class="average-grade-display" style="flex: 1;">
                <h3>Gesamtdurchschnitt</h3>
                <div class="grade-value">
                    @if (Model.AverageGrade > 0)
                    {
                        @Model.AverageGrade.ToString("F1")
                    }
                    else
                    {
                        <span style="color: #7dd3c0;">Keine Noten</span>
                    }
                </div>
            </div>
            <button type="button" id="saveAllGradesBtn" class="btn btn-primary" style="height: fit-content; padding: 12px 24px; font-weight: 600;">
                <i class="fas fa-save"></i> Alle Noten speichern
            </button>
        </div>
    </div>
</div>

<!-- Lehrjahre mit Modulen (bearbeitbar) -->
<div class="row">
    <div class="col-lg-12">
        @foreach (var yearGroup in Model.SchoolYearModules)
        {
            <div class="section mb-4">
                <div class="section-header">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <i class="fas fa-book"></i> @yearGroup.SchoolYearDescription
                        </div>
                        @if (yearGroup.YearAverageGrade.HasValue && yearGroup.YearAverageGrade > 0)
                        {
                            <span class="badge badge-primary">
                                Durchschnitt: @yearGroup.YearAverageGrade.Value.ToString("F1")
                            </span>
                        }
                    </div>
                </div>
                <div class="section-body">
                    @if (yearGroup.Modules.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50%;">Modul</th>
                                        <th style="width: 20%;">Modulcode</th>
                                        <th style="width: 30%;">Note (1.0 - 6.0)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var module in yearGroup.Modules)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@module.ModuleName</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-secondary">@module.ModuleCode</span>
                                            </td>
                                            <td style="display: flex; gap: 5px;">
                                                <input type="number"
                                                       class="grade-input form-control admin-grade-input"
                                                       data-module-id="@module.ModuleId"
                                                       data-grade-num="1"
                                                       step="0.1"
                                                       min="1.0"
                                                       max="6.0"
                                                       placeholder="Note 1"
                                                       style="flex: 1;" />
                                                <input type="number"
                                                       class="grade-input form-control admin-grade-input"
                                                       data-module-id="@module.ModuleId"
                                                       data-grade-num="2"
                                                       step="0.1"
                                                       min="1.0"
                                                       max="6.0"
                                                       placeholder="Note 2"
                                                       style="flex: 1;" />
                                                <input type="number"
                                                       class="grade-input form-control admin-grade-input"
                                                       data-module-id="@module.ModuleId"
                                                       data-grade-num="3"
                                                       step="0.1"
                                                       min="1.0"
                                                       max="6.0"
                                                       placeholder="Note 3"
                                                       style="flex: 1;" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Keine Module fuer dieses Lehrjahr.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Zurueck-Button -->
<div class="row mt-4">
    <div class="col-lg-12">
        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Zurueck zum Dashboard
        </a>
    </div>
</div>

<!-- CSRF Token -->
@Html.AntiForgeryToken()

<!-- JavaScript fuer Admin-Notenspeicherung -->
<script>
    $(document).ready(function () {
        var studentId = @Model.StudentId;

        // Validierung einzelner Note
        function validateGrade(value) {
            if (!value) return true; // Leere Felder sind OK
            if (isNaN(value) || value < 1.0 || value > 6.0) return false;
            return true;
        }

        // Save All Grades Button
        $("#saveAllGradesBtn").on("click", function () {
            var isValid = true;

            // Sammle alle Noten pro Modul
            var modules = {};
            $(".admin-grade-input").each(function () {
                var moduleId = $(this).data("module-id");
                var gradeNum = $(this).data("grade-num");
                var gradeValue = $(this).val();

                if (!validateGrade(gradeValue)) {
                    alert("Note muss zwischen 1.0 und 6.0 liegen oder leer sein!");
                    isValid = false;
                    return false;
                }

                if (!modules[moduleId]) {
                    modules[moduleId] = {};
                }
                modules[moduleId]["grade" + gradeNum] = gradeValue;
            });

            if (!isValid) return;

            // Speichere alle Module
            var moduleIds = Object.keys(modules);
            var completed = 0;

            $.each(modules, function (moduleId, grades) {
                console.log("Sending grades for module", moduleId, grades);
                $.ajax({
                    url: '@Url.Action("EditGrades", "Admin")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: {
                        studentId: studentId,
                        moduleId: moduleId,
                        grade1: grades.grade1 || "",
                        grade2: grades.grade2 || "",
                        grade3: grades.grade3 || ""
                    },
                    success: function (response) {
                        console.log("Success response:", response);
                        completed++;
                        if (completed === moduleIds.length) {
                            // Update average without reloading
                            if (response.averageGrade) {
                                $(".grade-value").text(response.averageGrade.toFixed(1));
                            }
                            alert("Alle Noten gespeichert!");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("Error:", xhr.status, xhr.responseText);
                        alert("Fehler: " + xhr.responseText);
                    }
                });
            });
        });
    });
</script>

<style>
    .section {
        margin-bottom: 30px;
    }

    .section-header {
        background: linear-gradient(135deg, #1b4d5c 0%, #7dd3c0 100%);
        padding: 15px 20px;
        border-radius: 8px 8px 0 0;
        color: white;
        border-bottom: 2px solid #7dd3c0;
        font-weight: 600;
    }

    .section-body {
        background-color: #0f2f38;
        padding: 0;
        border: 1px solid #7dd3c0;
        border-top: none;
        border-radius: 0 0 8px 8px;
    }

    .grade-input {
        background-color: #0d1a1f;
        border: 1px solid #7dd3c0;
        color: #d4f0e8;
        text-align: center;
        font-weight: bold;
        border-radius: 6px;
        padding: 8px;
        transition: all 0.3s ease;
    }

    .grade-input:focus {
        border-color: #a8e6d8;
        box-shadow: 0 0 0 0.2rem rgba(125, 211, 192, 0.25);
        background-color: #0d1a1f;
        color: #d4f0e8;
    }

    .badge-secondary {
        background-color: #2c6b7d;
    }

    .average-grade-display {
        background: linear-gradient(135deg, #1b4d5c 0%, #7dd3c0 100%);
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        margin: 20px 0;
    }

    .average-grade-display h3 {
        color: #a4d9d0;
        margin-bottom: 10px;
    }

    .average-grade-display .grade-value {
        font-size: 2.5rem;
        color: white;
        font-weight: bold;
    }

    h1 {
        color: white;
        margin-bottom: 10px;
    }

    .btn-secondary {
        background-color: #2c6b7d;
        border-color: #2c6b7d;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #5a9a8f;
        border-color: #5a9a8f;
        box-shadow: 0 4px 15px rgba(44, 107, 125, 0.3);
    }
</style>

