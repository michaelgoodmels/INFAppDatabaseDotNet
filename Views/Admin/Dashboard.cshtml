@model List<INFAppDatabaseDotNet.Models.Student>

@{
    ViewBag.Title = "Admin-Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <h1><i class="fas fa-tachometer-alt"></i> Admin-Dashboard</h1>
        <p class="text-muted">Ãœbersicht aller SchÃ¼ler und deren Notenverwaltung</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-users"></i> SchÃ¼ler gesamt</h5>
                <p class="card-text" style="font-size: 2.5rem; color: #60a5fa; font-weight: bold;">@Model.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-list"></i> Alle Noten</h5>
                <p class="card-text" style="font-size: 1.5rem;">
                    <a href="@Url.Action("AllGrades", "Admin")" style="color: #60a5fa; text-decoration: none;">
                        <i class="fas fa-arrow-right"></i> Anzeigen
                    </a>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-chart-bar"></i> Statistiken</h5>
                <p class="card-text" style="font-size: 1.5rem;">
                    <a href="@Url.Action("Statistics", "Admin")" style="color: #60a5fa; text-decoration: none;">
                        <i class="fas fa-arrow-right"></i> Anzeigen
                    </a>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-user-check"></i> Profil</h5>
                <p class="card-text" style="font-size: 1rem;">
                    <a href="@Url.Action("Index", "Login")" style="color: #60a5fa; text-decoration: none;">
                        Abmelden
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- SchÃ¼ler-Tabelle -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user-graduate"></i> Alle SchÃ¼ler</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Nr.</th>
                                    <th>Vorname</th>
                                    <th>Nachname</th>
                                    <th>Geschlecht</th>
                                    <th>Wohnort</th>
                                    <th>Lehrperson</th>
                                    <th>Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int counter = 1;}
                                @foreach (var student in Model)
                                {
                                    <tr>
                                        <td>@counter</td>
                                        <td>
                                            <strong>@student.FirstName</strong>
                                        </td>
                                        <td>@student.LastName</td>
                                        <td>
                                            @if (student.Gender == 'm')
                                            {
                                                <span class="badge badge-primary">
                                                    <i class="fas fa-mars"></i> MÃ¤nnlich
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-info">
                                                    <i class="fas fa-venus"></i> Weiblich
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @student.City, @student.PostalCode
                                        </td>
                                        <td>@student.TeacherName</td>
                                        <td>
                                            <a href="@Url.Action("StudentDetails", "Admin", new { studentId = student.StudentId })"
                                               class="btn btn-sm btn-primary" title="Noten anzeigen">
                                                <i class="fas fa-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                    counter++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info m-3" role="alert">
                        <i class="fas fa-info-circle"></i> Keine SchÃ¼ler gefunden.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: #1e293b;
        border: 1px solid #3b82f6;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
        color: #e2e8f0;
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.2);
    }

    .card-header {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        border-bottom: 2px solid #3b82f6;
        color: white;
        border-radius: 8px 8px 0 0;
    }

    .card-body {
        background-color: #1e293b;
    }

    .table-dark tbody tr:hover {
        background-color: #0f172a;
    }

    .badge-info {
        background-color: #0c4a6e;
    }

    .btn-primary {
        background-color: #3b82f6;
        border-color: #3b82f6;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #1e3a8a;
        border-color: #1e3a8a;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    }

    h1 {
        color: white;
        margin-bottom: 20px;
    }
</style>

