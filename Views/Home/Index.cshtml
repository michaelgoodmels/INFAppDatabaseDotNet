@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Willkommen</h1>
    <p class="text-muted">Notenverwaltungssystem für Informatiker Applikationsentwickler</p>

    <!-- Developer Illustration -->
    <svg width="300" height="300" viewBox="0 0 300 300" style="margin: 30px 0;" xmlns="http://www.w3.org/2000/svg">
        <!-- Monitor -->
        <rect x="50" y="80" width="200" height="130" fill="#1b4d5c" stroke="#7dd3c0" stroke-width="2" rx="5"/>

        <!-- Monitor Screen -->
        <rect x="60" y="90" width="180" height="100" fill="#0f2f38" rx="3"/>

        <!-- Code lines -->
        <line x1="70" y1="105" x2="150" y2="105" stroke="#7dd3c0" stroke-width="2"/>
        <line x1="70" y1="120" x2="200" y2="120" stroke="#4DB8AC" stroke-width="2"/>
        <line x1="70" y1="135" x2="180" y2="135" stroke="#7dd3c0" stroke-width="2"/>
        <line x1="70" y1="150" x2="220" y2="150" stroke="#4DB8AC" stroke-width="2"/>
        <line x1="70" y1="165" x2="170" y2="165" stroke="#7dd3c0" stroke-width="2"/>

        <!-- Monitor Stand -->
        <rect x="110" y="210" width="80" height="15" fill="#1b4d5c" stroke="#7dd3c0" stroke-width="2" rx="3"/>

        <!-- Base -->
        <ellipse cx="150" cy="230" rx="50" ry="8" fill="#7dd3c0"/>

        <!-- Person Head -->
        <circle cx="150" cy="40" r="20" fill="#d4a574"/>

        <!-- Person Body -->
        <rect x="130" y="60" width="40" height="50" fill="#1b4d5c" rx="5"/>

        <!-- Arms -->
        <line x1="130" y1="75" x2="80" y2="95" stroke="#d4a574" stroke-width="8" stroke-linecap="round"/>
        <line x1="170" y1="75" x2="220" y2="95" stroke="#d4a574" stroke-width="8" stroke-linecap="round"/>

        <!-- Hands -->
        <circle cx="80" cy="95" r="6" fill="#d4a574"/>
        <circle cx="220" cy="95" r="6" fill="#d4a574"/>
    </svg>

    <div class="mt-4">
        <a href="/Login" class="btn btn-primary btn-lg" style="background-color: #1b4d5c; border-color: #1b4d5c;">
            <i class="fas fa-sign-in-alt"></i> Zum Login
        </a>
    </div>
</div>

<style>
    .text-center {
        padding: 40px 20px;
    }

    .display-4 {
        color: white;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .text-muted {
        color: #a8e6d8 !important;
        font-size: 1.2rem;
        margin-bottom: 30px;
    }
</style>
